# Ingest bearer token (receiver stores theirs at /root/.config/anime-rss/upstream-auth.env).
# Configure on the collector host only — never commit the real value.
ANIME_INGEST_TOKEN=

# Optional overrides
ANIME_INGEST_URL=https://tomy.wutsuu0577.sbs/feeds/ingest
# Max articles to enrich per source listing (default 12)
CRAWL_LIMIT_PER_SOURCE=12
# User-Agent for source fetches
CRAWL_USER_AGENT=celadon-crawl/0.1 (+https://lowbculture.com; crawl-only)
